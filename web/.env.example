# Copy to .env.local for development. Never commit real values.

# Postgres connection used by the server (Supabase: Connect > Transaction pooler).
# Required: the server refuses to start without it. On Vercel with the Supabase
# integration, leave it unset: the app falls back to POSTGRES_URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Optional connection for `npm run db:migrate` (Supabase: Connect > Session pooler or Direct).
# Falls back to DATABASE_URL when empty.
MIGRATION_DATABASE_URL=

# Disposable local database for integration tests. It is wiped on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ssr_test

# Stripe (test mode keys in development). Used from the payment step onwards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend. Used from the email step onwards.
RESEND_API_KEY=

# First admin account, created once by `npm run admin:bootstrap` (and by every production
# deploy until an admin exists). The password is temporary: the admin must replace it at
# first sign-in. At least 12 characters. Set these in Vercel only; never commit real values.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Encrypts the keys the owner pastes on /admin/connections (Stripe now, Resend later).
# 32 random bytes, base64: `openssl rand -base64 32`. Set once per environment by the
# site team; changing it means pasting the keys again.
SECRETS_KEY=

# Public address of the live site. Stripe's webhook is created for this address.
# On Vercel it falls back to the production domain, so it can stay empty there.
SITE_URL=

# Protects the daily job (/api/cron/daily). Any random string of 16+ characters;
# Vercel sends it automatically with each cron call once it is set in the project.
CRON_SECRET=
