# Copy to .env.local for development. Never commit real values.

# Postgres connection used by the server (Supabase: Connect > Transaction pooler).
# Required: the server refuses to start without it. On Vercel with the Supabase
# integration, leave it unset: the app falls back to POSTGRES_URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Optional connection for `npm run db:migrate` (Supabase: Connect > Session pooler or Direct).
# Falls back to DATABASE_URL when empty.
MIGRATION_DATABASE_URL=

# Disposable local database for integration tests. It is wiped on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ssr_test

# Stripe (test mode keys in development). Used from the payment step onwards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend. Used from the email step onwards.
RESEND_API_KEY=
