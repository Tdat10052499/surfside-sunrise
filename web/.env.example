# Copy to .env.local for development. Never commit real values.

# Postgres connection used by the server (Supabase: Project Settings > Database).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Disposable local database for integration tests. It is wiped on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ssr_test

# Stripe (test mode keys in development). Used from the payment step onwards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend. Used from the email step onwards.
RESEND_API_KEY=
